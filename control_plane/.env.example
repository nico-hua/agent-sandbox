# 运行时类型。当前只支持 docker，留空时使用 docker。
AGENT_SANDBOX_RUNTIME=docker

# 管理员认证。填 true 或 false，默认 false。
AGENT_SANDBOX_AUTH_ENABLED=

# 管理员 Bearer key。启用认证时必填，可用 secrets.token_urlsafe(32) 生成。
AGENT_SANDBOX_API_KEY=

# SQLite 文件路径。相对路径以 control_plane/ 为基准，默认 .local/lifecycle.sqlite3。
AGENT_SANDBOX_DATABASE_PATH=

# 控制面就绪探测超时，单位为秒，默认 1。
AGENT_SANDBOX_READINESS_TIMEOUT=

# 实例和工作区查询超时，单位为秒，默认 1。
AGENT_SANDBOX_SANDBOX_QUERY_TIMEOUT=

# 是否启用过期实例回收，填 true 或 false，默认 true。
AGENT_SANDBOX_REAPER_ENABLED=

# 回收轮次之间的间隔，单位为秒，默认 60。
AGENT_SANDBOX_REAPER_INTERVAL_SECONDS=

# 每轮最多检查的回收候选数，默认 100。
AGENT_SANDBOX_REAPER_BATCH_LIMIT=

# 是否在启动时核验和恢复 pending 实例，填 true 或 false，默认 false。
AGENT_SANDBOX_PENDING_RECOVERY_ENABLED=

# 启动恢复最多检查的 pending 候选数，默认 100。
AGENT_SANDBOX_PENDING_RECOVERY_BATCH_LIMIT=

# 同时创建实例的最大数量，支持 1 至 16，默认 2。
AGENT_SANDBOX_MAX_CONCURRENT_CREATES=

# 控制面允许管理的实例总量，支持 1 至 1024，默认 10。
AGENT_SANDBOX_MAX_INSTANCES=

# 自定义环境名到本地 Docker 镜像的 JSON 对象，例如 '{"tools":"agent-sandbox-tools:dev"}'。
# 留空时仅注册内置环境 basic、python 和 node。
AGENT_SANDBOX_ADDITIONAL_ENVIRONMENTS=
